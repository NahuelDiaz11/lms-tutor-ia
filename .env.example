# ==============================================================================
# Class-Edtech Learning - Variables de Entorno (POC LMS con Tutor IA y Voz)
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# Base de Datos (SQLite local por defecto, sin dependencias externas requeridas)
DATABASE_URL="file:./dev.db"

# Proveedor de IA para el Tutor Pedagógico (Opciones: "mock", "gemini", "openai")
# Por defecto se utiliza "mock", que opera 100% offline, sin costo ni API keys.
AI_PROVIDER="mock"

# Clave secreta para firma y verificación de sesiones de usuario (Cookies HTTP-Only)
JWT_SECRET="poc-lms-tutor-secret-key-38294719"

# ------------------------------------------------------------------------------
# PROVEEDORES DE PRODUCCIÓN OPCIONALES (No requeridos para evaluar la POC)
# Si deseas probar con modelos de producción reales, descomenta la opción deseada:
# ------------------------------------------------------------------------------
# GEMINI_API_KEY="tu_clave_de_google_gemini"
# OPENAI_API_KEY="tu_clave_de_openai"
